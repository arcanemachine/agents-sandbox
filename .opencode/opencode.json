{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "disable_paste_summary": true
  },
  "mode": {
    "simple-agent": {
      "prompt": "{file:./prompts/simple-agent.txt}"
    }
  },
  "plugin": ["opencode-pty", "opencode-notify-marker"],
  "provider": {
    "llama-beast": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-beast",
      "options": {
        "baseURL": "http://192.168.1.135:8080/v1"
      },
      "models": {
        "Qwen3-Coder-Next-Q4_K_M.gguf": {
          "name": "Qwen3-Coder-Next-Q4_K_M.gguf",
          "limit": { "context": 120000, "output": 8000 }
        }
      }
    },
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-local",
      "options": {
        "baseURL": "http://192.168.1.100:8081/v1"
      },
      "models": {
        "Qwen3-Coder-Next-UD-TQ1_0.gguf": {
          "name": "Qwen3-Coder-Next-UD-TQ1_0.gguf",
          "limit": { "context": 64000, "output": 8000 }
        },
        "Qwen3.5": {
          "name": "Qwen3.5-35B-A3B-Q3_K_M.gguf",
          "limit": { "context": 64000, "output": 8000 }
        }
      }
    },
    "nanogpt-custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NanoGPT (Custom models)",
      "options": {
        "baseURL": "https://nano-gpt.com/api/subscription/v1"
      },
      "models": {
        "moonshotai/kimi-k2.5:thinking": {
          "name": "Kimi K2.5 (Thinking)",
          "limit": { "context": 200000, "output": 32000 }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://172.16.0.1:11434/v1"
      },
      "models": {
        "qwen3-coder-30b-a3b-instruct:latest": {
          "name": "Qwen3 Coder 30B",
          "supportsTools": true,
          "limit": { "context": 16000, "output": 8000 }
        },
        "qwen3-4b:latest": {
          "name": "Qwen3 4B",
          "supportsTools": true,
          "limit": { "context": 64000, "output": 16000 }
        },
        "glm-4.7-flash:latest": {
          "name": "GLM 4.7 Flash",
          "supportsTools": true
        }
      }
    },
    "openrouter-custom": {
      "name": "OpenRouter (Custom)",
      "api": "openai-completions",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.1": {
          "name": "GLM 5.1",
          "contextWindow": 200000,
          "maxTokens": 120000
        }
      }
    },
    "openrouter-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (Free)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_FREE_API_KEY}"
      },
      "models": {
        "openrouter/pony-alpha": {
          "limit": {
            "context": 200000,
            "output": 120000
          }
        }
      }
    }
  }
}
